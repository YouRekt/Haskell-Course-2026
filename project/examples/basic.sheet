# A small example sheet showing off most of the language.
# Run it with:  stack run -- examples/basic.sheet

sheet {
  A1 = 10;
  A2 = 20;
  A3 = A1 + A2;          # 30
  A4 = SUM(A1:A3);       # 10 + 20 + 30 = 60
  A5 = AVG(A1:A3);       # 60 / 3 = 20

  B1 = A4 > A5;          # TRUE
  B2 = A1 * (A2 - 5);    # 10 * 15 = 150

  C1 = "total";          # a string literal
  C2 = 100 / 0;          # division by zero -> #ERR(div0)
}
